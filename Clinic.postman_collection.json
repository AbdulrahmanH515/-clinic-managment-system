    {
      "name": "8. Error Handling Examples",
      "item": [
        {
          "name": "Validation Error (Blank First Name)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"\",\n    \"lastName\": \"Ali\",\n    \"email\": \"bad.patient@example.com\",\n    \"phone\": \"01000000000\",\n    \"dateOfBirth\": \"1995-05-10\",\n    \"gender\": \"MALE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/patients", "host": ["{{baseUrl}}"], "path": ["api", "patients"] },
            "description": "Expected: 400 Bad Request"
          },
          "response": []
        },
        {
          "name": "Duplicate Email (409)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"Ahmed\",\n    \"lastName\": \"Ali\",\n    \"email\": \"ahmed.ali@example.com\",\n    \"phone\": \"01012345678\",\n    \"dateOfBirth\": \"1995-05-10\",\n    \"gender\": \"MALE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/patients", "host": ["{{baseUrl}}"], "path": ["api", "patients"] },
            "description": "Expected: 409 Conflict — run after 'Create Patient' with the same email."
          },
          "response": []
        },
        {
          "name": "Patient Not Found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/patients/00000000-0000-0000-0000-000000000000", "host": ["{{baseUrl}}"], "path": ["api", "patients", "00000000-0000-0000-0000-000000000000"] },
            "description": "Expected: 404 Not Found"
          },
          "response": []
        },
        {
          "name": "Invalid Status Transition (409)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/complete", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}", "complete"] },
            "description": "Expected: 409 Conflict — call twice in a row (COMPLETED -> COMPLETED is not a valid transition)."
          },
          "response": []
        },
        {
          "name": "Medical Record on Non-Completed Appointment (409)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"diagnosis\": \"Test\",\n    \"treatment\": \"Test\",\n    \"notes\": \"Test\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/appointments/00000000-0000-0000-0000-000000000000/medical-record", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "00000000-0000-0000-0000-000000000000", "medical-record"] },
            "description": "Expected: 404 (unknown appointment) — swap in a real SCHEDULED appointment id to get 409 Appointment Not Completed instead."
          },
          "response": []
        },
        {
          "name": "Duplicate Medical Record (409)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"diagnosis\": \"Duplicate test\",\n    \"treatment\": \"test\",\n    \"notes\": \"test\"\n}",
              "options": { "raw": { "language": "json" } }
