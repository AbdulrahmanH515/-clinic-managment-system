{
  "info": {
    "name": "Clinic Appointment Management System",
    "description": "Full API collection covering Assignments 1-15: Specializations, Doctors, Doctor Availability, Patients, Appointments, Medical Records, and Prescriptions. Requests are chained with collection variables (auto-captured via test scripts) so the folders can be run top-to-bottom with the Postman Runner on a fresh (in-memory H2) database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "specializationId", "value": "" },
    { "key": "doctorId", "value": "" },
    { "key": "patientId", "value": "" },
    { "key": "appointmentId", "value": "" },
    { "key": "medicalRecordId", "value": "" },
    { "key": "prescriptionId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Specializations",
      "item": [
        {
          "name": "Create Specialization",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('specializationId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Cardiology\",\n    \"description\": \"Heart specialist\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/specializations", "host": ["{{baseUrl}}"], "path": ["api", "specializations"] }
          },
          "response": []
        },
        {
          "name": "Get All Specializations",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/specializations", "host": ["{{baseUrl}}"], "path": ["api", "specializations"] }
          },
          "response": []
        },
        {
          "name": "Get Specialization By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/specializations/{{specializationId}}", "host": ["{{baseUrl}}"], "path": ["api", "specializations", "{{specializationId}}"] }
          },
          "response": []
        },
        {
          "name": "Get Doctors By Specialization",
